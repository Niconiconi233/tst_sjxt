{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuditWorkspace",
  "version": "0.1.0",
  "identifier": "cn.audit.workspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "审计组工作管理系统",
        "width": 1480,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 Audit Workspace",
    "category": "Business",
    "shortDescription": "审计组工作管理系统",
    "longDescription": "面向审计机关派出审计组的审计项目、审计组与审计工作文件一体化管理工作台"
  }
}
